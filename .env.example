# Copy to .env. Never commit or send .env to a browser.
HOST=127.0.0.1
PORT=3000

# VPS / Docker deployment. Bare domain only; no https:// or path.
DOMAIN=your-domain.com
PUBLIC_ORIGIN=
TRUST_PROXY=false

# OpenAI-compatible Chat Completions API base (usually ends with /v1).
# Leave the key blank to use built-in readings.
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_NAME=
MODEL_JSON_MODE=true
# Some providers/models use max_completion_tokens instead.
MODEL_TOKEN_PARAMETER=max_tokens
MODEL_MAX_TOKENS=1400
MODEL_TIMEOUT_MS=25000
MODEL_FALLBACK=true

RATE_WINDOW_MS=60000
RATE_MAX=8
MODEL_MAX_CONCURRENT=3
MODEL_HOURLY_LIMIT=120
