# For a VPS that already runs Caddy as a system service (it owns ports 80/443).
# Install:  sed 's/YIQIAN_DOMAIN/your.domain/' deploy/host-caddy.caddy > /etc/caddy/yiqian.caddy
# then add "import /etc/caddy/yiqian.caddy" to /etc/caddy/Caddyfile and reload Caddy.
# Requests from Cloudflare (orange cloud) pass the real visitor IP from
# CF-Connecting-IP; direct requests use the peer address, so the header can't be
# spoofed by bypassing Cloudflare. Ranges: https://www.cloudflare.com/ips/
YIQIAN_DOMAIN {
	encode zstd gzip
	@cloudflare remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	handle @cloudflare {
		reverse_proxy 127.0.0.1:3000 {
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		}
	}
	handle {
		reverse_proxy 127.0.0.1:3000 {
			header_up X-Forwarded-For {remote_host}
		}
	}
}
